generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  role               Role     @default(STUDENT)
  hasChangedPassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studentProfile Student?
  facultyProfile Faculty?
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  faculties Faculty[]
  batches   Batch[]
}

model Faculty {
  id           String     @id // e.g., EMP-2026-0001
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  email        String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  coordinatedBatches Batch[] @relation("BatchCoordinator")
}

model Batch {
  id              String     @id @default(uuid())
  name            String     @unique // e.g., BCA-11
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  coordinatorId   String?
  coordinator     Faculty?   @relation("BatchCoordinator", fields: [coordinatorId], references: [id])
  academicSession String
  currentSemester Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  students Student[]
}

model Student {
  id        String   @id @default(uuid())
  rollNo    String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}